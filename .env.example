APP_NAME=id-game-distribution-python-workers
APP_ENV=local
HOST=127.0.0.1
PORT=8091
JAVA_CALLBACK_BASE_URL=http://127.0.0.1:8080/internal/creative/runs
CALLBACK_TIMEOUT_SECONDS=10
JOB_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS=2
DATABASE_PATH=data/worker.db
# Optional. Use logical profiles in POST /jobs, for example google_hk.
# Never commit a real proxy URL; it may contain a username/password.
PROXY_DEFAULT_URL=
# Profile-specific values use PROXY_PROFILE_<UPPERCASE_NAME>, for example:
# PROXY_PROFILE_GOOGLE_HK=socks5://user:password@proxy.example:1080
