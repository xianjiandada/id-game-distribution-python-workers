# 生产运行配置：可随项目直接上传到服务器项目根目录。部署前核对回调域名、目录和实际代理配置。
# 生产启动：python -m app --env-file .env.production
# 当前路径按 /data/opt/game/server/id-game-distribution-python-workers 部署约定填写，换目录时同步修改。
# 系统或宝塔注入的同名环境变量优先；本文件当前不含真实凭据，可随代码上传。

# 服务名称，用于健康检查返回值和日志识别。
APP_NAME=id-game-distribution-python-workers

# 运行环境标识：本地用 local，生产用 production；仅作为标识，不会自动切换配置文件。
APP_ENV=production

# 监听地址；与 Quartz 同机时使用 127.0.0.1，仅允许本机访问。
HOST=127.0.0.1

# 服务端口；当前 Java Quartz 固定调用本机 13371，改端口需同步修改 Java。
PORT=13371

# Java Manager 默认回调基础地址，不含 runID；任务传入的 callbackUrl 优先于此配置。
JAVA_CALLBACK_BASE_URL=https://api-manager.mar2game.com/internal/creative/runs

# 单次 Java HTTP 回调超时，单位秒；当前没有自动回调重试。
CALLBACK_TIMEOUT_SECONDS=10

# 单个 Worker 执行超时，单位秒；不包含等待并发名额的时间。
JOB_TIMEOUT_SECONDS=900

# 单进程内最多同时执行的任务数，不是进程数量；浏览器任务较耗内存。
MAX_CONCURRENT_JOBS=2

# Python SQLite 审计和最新素材存储路径；不是 Java MySQL，生产应放在共享数据目录。
DATABASE_PATH=/data/opt/game/server/id-game-distribution-python-workers/shared/data/worker.db

# Playwright 浏览器目录；必须与安装 Chromium 时使用的目录一致，并允许启动用户访问。
PLAYWRIGHT_BROWSERS_PATH=/data/opt/game/server/id-game-distribution-python-workers/shared/browsers

# 可选默认代理地址，留空不配置；当前 Quartz 未传代理参数，仅填写此项不会自动启用代理。
PROXY_DEFAULT_URL=

# 按逻辑名称配置代理：PROXY_PROFILE_<名称大写>，例如任务 proxyProfile=google_hk。
# 手工任务需要同时传代理参数；真实账号密码只填写在实际配置文件中。
# 下面是占位示例，使用时替换地址与凭据；带认证代理须先验证浏览器兼容性。
# PROXY_PROFILE_GOOGLE_HK=http://username:password@proxy.example.com:8080
